{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "catPet",
  "version": "0.1.0",
  "identifier": "com.musica.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "catPet",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Reproductor rápido sin anuncios",
    "longDescription": "Archivos locales, búsqueda instantánea, MPRIS/SMTC.",
    "linux": {
      "deb": {
        "depends": [
          "libmpv2",
          "libwebkit2gtk-4.1-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "wix": {},
      "nsis": {}
    },
    "resources": {
      "licenses/libmpv-LICENSE.LGPL": "licenses/libmpv-LICENSE.LGPL",
      "licenses/libmpv-LGPLv3.txt": "licenses/libmpv-LGPLv3.txt",
      "licenses/ffmpeg-COPYING.LGPLv2.1": "licenses/ffmpeg-COPYING.LGPLv2.1",
      "licenses/yt-dlp-LICENSE": "licenses/yt-dlp-LICENSE",
      "licenses/deno-LICENSE": "licenses/deno-LICENSE",
      "licenses/LEEME-licencias-y-sustitucion-libmpv.txt": "licenses/LEEME-licencias-y-sustitucion-libmpv.txt",
      "licenses/THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md"
    }
  }
}
