{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/libmpv-2.dll": "libmpv-2.dll",
      "licenses/LEEME-licencias-y-sustitucion-libmpv.txt": "licenses/LEEME-licencias-y-sustitucion-libmpv.txt",
      "licenses/THIRD-PARTY-NOTICES.md": "licenses/THIRD-PARTY-NOTICES.md",
      "binaries/yt-dlp-x86_64-pc-windows-msvc.exe": "bin/yt-dlp.exe",
      "binaries/deno-x86_64-pc-windows-msvc.exe": "bin/deno.exe",
      "binaries/ffmpeg-x86_64-pc-windows-msvc.exe": "bin/ffmpeg.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "Spanish",
          "English"
        ]
      }
    }
  }
}
